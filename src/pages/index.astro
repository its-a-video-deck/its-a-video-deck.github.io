---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import JournalCard from '../components/JournalCard.astro';
import SignalPath from '../components/SignalPath.astro';
const entries = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <section class="hero reference-hero wrap" aria-labelledby="hero-title">
    <div class="eyebrow">
      <span>A RESTOMOD EXPLORATION</span>
      <span>EST. 1979 — REIMAGINED 2026</span>
    </div>
    <div class="hero-title">
      <h1 id="hero-title">
        An analog
        <br />
        state of mind<span class="red">.</span>
      </h1>
      <div class="hero-intro">
        <span class="tiny">DIGITAL SOURCE. ANALOG SOUL.</span>
        <p>
          A physical video player.
          <br />
          An unlikely meeting of eras.
          <br />
          Built to bring the picture back.
        </p>
        <a class="text-link" href="#object">
          Meet the video deck <span>↓</span>
        </a>
      </div>
    </div>
    <figure class="hero-image">
      <img
        src="/images/deck-concept.png"
        alt="Concept rendering of a brushed aluminum video deck with walnut sides, a small screen and analog tuning controls"
        width="1672"
        height="941"
        fetchpriority="high"
      />
      <div class="image-tag">
        DIY VIDEO DECK
        <br />
        <span>VD—01 / CONCEPT STUDY</span>
      </div>
      <figcaption>
        <span>FIG. 01 — A NEW LIFE FOR AN OLD FORM</span>
        <span>AI-GENERATED CONCEPT · NOT THE ACTUAL BUILD</span>
      </figcaption>
    </figure>
    <div class="tuner" aria-hidden="true">
      <span>UHF</span>
      <div class="scale">
        <div class="numbers">
          <span>21</span>
          <span>25</span>
          <span>30</span>
          <span>35</span>
          <span>40</span>
          <span>45</span>
          <span>50</span>
          <span>60</span>
        </div>
        <i></i>
      </div>
      <span>TV TUNING</span>
    </div>
    <div class="hero-foot micro">
      <span>DESIGN / ELECTRONICS / SOFTWARE</span>
      <span class="amber-label">● WORK IN PROGRESS</span>
    </div>
  </section>
  <section id="object" class="editorial-section wrap">
    <div class="section-marker micro">
      <span>01 / THE OBJECT</span>
      <span>PAST MEETS PRESENT</span>
    </div>
    <div class="editorial-grid">
      <h2>
        Some things deserve
        <br />a second life.
      </h2>
      <div class="prose-intro">
        <p>
          What if a video player felt like a piece of Hi-Fi again? Something you
          switch on, tune in and make room for.
        </p>
        <p>
          This project explores that idea through a restomod deck: the physical
          language of late-seventies electronics, a contemporary video source,
          and a connection back to analog television.
        </p>
        <a class="text-link" href="#process">
          Inside the approach <span>↗</span>
        </a>
      </div>
    </div>
    <div class="object-details">
      <div>
        <span class="micro">01 / FORM</span>
        <h3>A familiar presence.</h3>
        <p>
          Brushed metal, black glass and deliberate controls. A piece of
          equipment, with its own place on the shelf.
        </p>
      </div>
      <div>
        <span class="micro">02 / FUNCTION</span>
        <h3>A different purpose.</h3>
        <p>
          Local video playback, a repurposed display and an analog output path.
          Old and new, working together.
        </p>
      </div>
      <div>
        <span class="micro">03 / FEELING</span>
        <h3>A slower kind of media.</h3>
        <p>
          Choose a programme. Press a button. Watch a picture. A small ritual
          worth keeping.
        </p>
      </div>
    </div>
  </section>
  <section id="signal" class="signal-section">
    <div class="wrap">
      <div class="section-marker micro">
        <span>02 / SIGNAL PATH</span>
        <span>FROM FILE TO FREQUENCY</span>
      </div>
      <div class="section-title">
        <h2>
          Modern source.
          <br />
          Analog destination.
        </h2>
        <p>
          Four stages. Two generations of technology.
          <br />
          Follow the picture from storage to screen.
        </p>
      </div>
      <SignalPath />
    </div>
  </section>
  <section id="process" class="editorial-section wrap">
    <div class="section-marker micro">
      <span>03 / THE APPROACH</span>
      <span>KEEP / REPLACE / ADD</span>
    </div>
    <div class="editorial-grid">
      <h2>
        Preserve the character.
        <br />
        Rethink the inside.
      </h2>
      <p class="large-copy">
        The interesting part happens between what an object was and what it
        could become.
      </p>
    </div>
    <div class="process-grid">
      <div>
        <span class="process-number">01</span>
        <h3>Keep.</h3>
        <p>
          The proportions. The tactile controls. The visual restraint of a
          well-made piece of Hi-Fi.
        </p>
        <span class="micro">CHARACTER & MATERIALS</span>
      </div>
      <div>
        <span class="process-number">02</span>
        <h3>Replace.</h3>
        <p>
          The original playback function with a video system designed around
          local media.
        </p>
        <span class="micro">PURPOSE & PLAYBACK</span>
      </div>
      <div>
        <span class="process-number">03</span>
        <h3>Add.</h3>
        <p>
          A display, software control and a service interface, integrated with
          the original design language.
        </p>
        <span class="micro">CAPABILITY & CONTROL</span>
      </div>
    </div>
  </section>
  <section class="journal-section wrap">
    <div class="section-marker micro">
      <span>04 / BUILD LOG</span>
      <span>NOTES FROM THE WORKBENCH</span>
    </div>
    <div class="section-title">
      <h2>A project, in pieces.</h2>
      <a class="text-link" href="/journal/">
        All project notes <span>↗</span>
      </a>
    </div>
    <div class="journal-grid">
      {entries.map((entry) => (
        <JournalCard entry={entry} />
      ))}
    </div>
    <p class="editorial-note">
      Initial project notes — design intentions and open questions, ready to
      grow into a build journal.
    </p>
  </section>
  <section id="about" class="about-section wrap">
    <span class="micro">05 / ABOUT THE PROJECT</span>
    <div>
      <h2>Made out of curiosity.</h2>
      <p>
        DIY Video Deck is an independent exploration of objects, interfaces and
        the way we watch. Part electronics project, part design exercise, part
        love letter to the equipment we grew up with.
      </p>
      <p>
        This is the notebook: the decisions, the experiments and the details
        along the way.
      </p>
      <a class="text-link" href="/journal/">
        Open the notebook <span>↗</span>
      </a>
    </div>
    <div class="about-stamp micro">
      DESIGNED TO BE
      <br />
      TAKEN APART.
      <br />
      <span>
        AND PUT BACK
        <br />
        TOGETHER.
      </span>
    </div>
  </section>
</Layout>
