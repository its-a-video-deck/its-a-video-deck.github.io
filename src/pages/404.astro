---
import Layout from '../layouts/Layout.astro';
import { getPage, localizedPath } from '../i18n/utils';

const copy = (await getPage('en', 'not-found')).data;
const copyFr = (await getPage('fr', 'not-found')).data;
const homeEn = localizedPath('en', '/');
const homeFr = localizedPath('fr', '/');
---

<Layout
  title={copy.metaTitle}
  description={copy.text}
  localeRedirect={false}
  pagePath="/"
>
  <section class="not-found wrap" data-not-found>
    <div data-404-lang="en" data-title={copy.metaTitle}>
      <span class="micro">{copy.kicker}</span>
      <h1>
        {copy.headingLine1}
        <br />
        {copy.headingLine2}
      </h1>
      <p>{copy.text}</p>
      <a class="text-link" href={homeEn}>
        {copy.cta}
      </a>
    </div>
    <div data-404-lang="fr" data-title={copyFr.metaTitle} hidden>
      <span class="micro">{copyFr.kicker}</span>
      <h1>
        {copyFr.headingLine1}
        <br />
        {copyFr.headingLine2}
      </h1>
      <p>{copyFr.text}</p>
      <a class="text-link" href={homeFr}>
        {copyFr.cta}
      </a>
    </div>
  </section>
</Layout>
<script>
  const root = document.documentElement;
  const key = root.getAttribute('data-locale-key');
  const supported = ['en', 'fr'];
  function preferredLocale() {
    try {
      const stored = key ? localStorage.getItem(key) : null;
      if (stored && supported.includes(stored)) return stored;
    } catch {
      /* private mode */
    }
    const list = navigator.languages?.length
      ? navigator.languages
      : [navigator.language];
    for (const candidate of list) {
      const code = candidate.toLowerCase().split('-')[0];
      if (supported.includes(code)) return code;
    }
    return 'en';
  }
  const lang = preferredLocale();
  root.lang = lang;
  root.setAttribute('data-locale', lang);
  document.querySelectorAll('[data-404-lang]').forEach((panel) => {
    const panelLang = panel.getAttribute('data-404-lang');
    const visible = panelLang === lang;
    (panel as HTMLElement).hidden = !visible;
    if (visible) {
      const title = panel.getAttribute('data-title');
      if (title) document.title = title;
    }
  });
</script>
