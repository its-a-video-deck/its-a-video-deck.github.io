---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JournalCard from '../../components/JournalCard.astro';
const entries = (
  await getCollection('journal', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Build log — DIY Video Deck"
  description="Design intentions, hardware questions and software notes from the DIY Video Deck project."
>
  <section class="journal-page wrap">
    <a href="/" class="micro breadcrumb">
      ← BACK TO THE PROJECT
    </a>
    <div class="section-marker micro">
      <span>THE WORKBENCH / PROJECT NOTES</span>
      <span>AN OPEN NOTEBOOK</span>
    </div>
    <h1>
      A project,
      <br />
      <span>in pieces.</span>
    </h1>
    <p class="page-intro">
      Design decisions, experiments and things still to figure out.
      <br />A record of the process, one detail at a time.
    </p>
    <div class="journal-tools" id="journal-tools" hidden>
      <div class="filters" role="group" aria-label="Filter by category">
        {['All', 'Design', 'Hardware', 'Software'].map((category) => (
          <button
            type="button"
            data-filter={category}
            aria-pressed={category === 'All' ? 'true' : 'false'}
          >
            {category}
          </button>
        ))}
      </div>
      <label class="search-label">
        <span class="sr-only">Search project notes</span>
        <input
          id="journal-search"
          type="search"
          placeholder="Search the notebook…"
        />
      </label>
    </div>
    <p class="micro result-count" id="result-count" aria-live="polite">
      {entries.length} PROJECT NOTES
    </p>
    <div class="journal-grid">
      {entries.map((entry) => (
        <JournalCard entry={entry} />
      ))}
    </div>
    <div class="empty-state" id="empty-state" hidden>
      <h2>No matching notes.</h2>
      <p>Try another word or explore a different category.</p>
      <button type="button" id="reset-filters" class="text-link">
        Clear filters ↗
      </button>
    </div>
    <p class="editorial-note">
      These initial notes document intentions, not completed tests or a verified
      hardware specification.
    </p>
  </section>
</Layout>
<script>
  const controls = document.getElementById('journal-tools');
  const search = document.querySelector<HTMLInputElement>('#journal-search');
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-category]'),
  );
  let category = 'All';
  function updateResults() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let count = 0;
    cards.forEach((card) => {
      const matches =
        (category === 'All' || card.dataset.category === category) &&
        (card.dataset.title ?? '').toLowerCase().includes(query);
      card.hidden = !matches;
      if (matches) count++;
    });
    filters.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.filter === category),
      ),
    );
    const countLabel = document.getElementById('result-count');
    const emptyState = document.getElementById('empty-state');
    if (countLabel)
      countLabel.textContent = `${count} PROJECT ${count === 1 ? 'NOTE' : 'NOTES'}`;
    if (emptyState) emptyState.hidden = count !== 0;
  }
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.filter ?? 'All';
      updateResults();
    }),
  );
  search?.addEventListener('input', updateResults);
  document.getElementById('reset-filters')?.addEventListener('click', () => {
    category = 'All';
    if (search) search.value = '';
    updateResults();
    search?.focus();
  });
  if (controls) controls.hidden = false;
</script>
