---
import { getLang, useCopy } from '../i18n/utils';

interface Props {
  variant: 'scale' | 'display' | 'signal';
}

const { variant } = Astro.props;
const copy = useCopy(getLang(Astro.currentLocale)).visual;
---

<div class:list={['technical-visual', `visual-${variant}`]} aria-hidden="true">
  {variant === 'scale' && (
    <div class="mini-tuner">
      <div class="micro">
        UHF <span>{copy.channel}</span>
      </div>
      <div class="tuner-numbers">
        <span>21</span>
        <span>30</span>
        <span>40</span>
        <span>50</span>
        <span>60</span>
      </div>
      <div class="tuner-ticks"></div>
      <div class="tuner-needle"></div>
      <div class="micro">
        BAND IV / V <span>MHz</span>
      </div>
    </div>
  )}
  {variant === 'display' && (
    <div class="mini-screen">
      <div class="test-circle">
        <span>
          {copy.video}
          <br />
          {copy.signal}
        </span>
      </div>
      <span class="screen-label">{copy.displayStudy}</span>
    </div>
  )}
  {variant === 'signal' && (
    <div class="mini-signal">
      <div class="micro">{copy.sequence}</div>
      <div class="boot-row">
        <span>01</span>
        <span>{copy.power}</span>
        <i></i>
      </div>
      <div class="boot-row">
        <span>02</span>
        <span>{copy.source}</span>
        <i></i>
      </div>
      <div class="boot-row">
        <span>03</span>
        <span>{copy.picture}</span>
        <i></i>
      </div>
    </div>
  )}
</div>
