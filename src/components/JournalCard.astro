---
import type { CollectionEntry } from 'astro:content';
import { getLang, journalSlug, localizedPath, useCopy } from '../i18n/utils';
import TechnicalVisual from './TechnicalVisual.astro';

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const lang = getLang(Astro.currentLocale);
const copy = useCopy(lang);
const category = copy.category[entry.data.category];
const href = localizedPath(lang, `/journal/${journalSlug(entry)}/`);
const searchText = [
  entry.data.title,
  entry.data.description,
  category,
  copy.perspectives[entry.data.perspective],
  copy.entryTypes[entry.data.entryType],
  entry.body ?? '',
]
  .join(' ')
  .replace(/[#>*_\[\]()]/g, ' ');
---

<article
  class="journal-card"
  data-category={entry.data.category}
  data-title={searchText}
>
  <a href={href} class="journal-card-link">
    <TechnicalVisual variant={entry.data.visual} />
    <div class="card-meta micro">
      <span>
        {entry.data.number} / {category}
      </span>
      <span>
        {copy.perspectives[entry.data.perspective] ?? entry.data.perspective}{' '}
        · {copy.entryTypes[entry.data.entryType] ?? entry.data.entryType}
      </span>
    </div>
    <h3>
      {entry.data.title}
      <span aria-hidden="true">↗</span>
    </h3>
    <p>{entry.data.description}</p>
  </a>
</article>
