---
import Layout from '../layouts/Layout.astro';
import StoryFigure from './StoryFigure.astro';
import { getLang, getPage, localizedPath, useCopy } from '../i18n/utils';
import { parseStoryMarkdown } from '../lib/story-markdown';

const lang = getLang(Astro.currentLocale);
const entry = await getPage(lang, 'story');
const page = entry.data;
const sections = parseStoryMarkdown(entry.body ?? '');
const homeHref = localizedPath(lang, '/');
const journalHref = localizedPath(lang, '/journal/');
const back = useCopy(lang).layout.backToProject;
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <article class="story-page wrap">
    <a href={homeHref} class="micro breadcrumb">
      {back}
    </a>
    <header class="article-header">
      <div class="micro">{page.kicker}</div>
      <h1>
        {page.titleLine1}
        <br />
        <span>{page.titleLine2}</span>
      </h1>
      <p>{page.dek}</p>
      <p class="micro story-written">{page.written}</p>
    </header>
    {sections.map((section) => (
      <section class="story-section">
        <div class="article-body">
          <h2>{section.heading}</h2>
          <Fragment set:html={section.html} />
        </div>
        {section.figure && (
          <StoryFigure
            id={section.figure}
            figure={page.figures[section.figure]}
          />
        )}
      </section>
    ))}
    <div class="article-end story-end">
      <span class="micro">{page.end}</span>
      <div class="story-next">
        <p>{page.nextText}</p>
        <a class="text-link" href={journalHref}>
          {page.nextCta} <span>↗</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
