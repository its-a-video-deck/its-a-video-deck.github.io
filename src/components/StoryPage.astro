---
import Layout from '../layouts/Layout.astro';
import StoryFigure from './StoryFigure.astro';
import { getLang, localizedPath, useCopy } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const page = useCopy(lang).story;
const homeHref = localizedPath(lang, '/');
const journalHref = localizedPath(lang, '/journal/');
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <article class="story-page wrap">
    <a href={homeHref} class="micro breadcrumb">
      {page.back}
    </a>
    <header class="article-header">
      <div class="micro">{page.kicker}</div>
      <h1>
        {page.titleLine1}
        <br />
        <span>{page.titleLine2}</span>
      </h1>
      <p>{page.dek}</p>
      <p class="micro story-written">{page.written}</p>
    </header>
    {
      page.sections.map((section) => (
        <section class="story-section">
          <div class="article-body">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            {section.quote && <blockquote>{section.quote}</blockquote>}
          </div>
          {section.figure && (
            <StoryFigure id={section.figure} figure={page.figures[section.figure]} />
          )}
        </section>
      ))
    }
    <div class="article-end story-end">
      <span class="micro">{page.end}</span>
      <div class="story-next">
        <p>{page.nextText}</p>
        <a class="text-link" href={journalHref}>
          {page.nextCta} <span>↗</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
