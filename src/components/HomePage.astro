---
import Layout from '../layouts/Layout.astro';
import {
  getJournalEntries,
  getLang,
  getPage,
  localizedPath,
} from '../i18n/utils';
import JournalCard from './JournalCard.astro';
import SignalPath from './SignalPath.astro';

const lang = getLang(Astro.currentLocale);
const page = (await getPage(lang, 'home')).data;
const { hero, object, signal, process, journal, about } = page;
const entries = (await getJournalEntries(lang)).slice(0, 3);
const storyHref = localizedPath(lang, '/story/');
const journalHref = localizedPath(lang, '/journal/');
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <section class="hero reference-hero wrap" aria-labelledby="hero-title">
    <div class="eyebrow">
      <span>{hero.eyebrowKicker}</span>
      <span>{hero.eyebrowEra}</span>
    </div>
    <div class="hero-title">
      <h1 id="hero-title">
        {hero.titleLine1}
        <br />
        {hero.titleLine2}
        <span class="red">.</span>
      </h1>
      <div class="hero-intro">
        <span class="tiny">{hero.tiny}</span>
        <p>
          {hero.intro.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
        <a class="text-link" href="#object">
          {hero.meetCta} <span>↓</span>
        </a>
      </div>
    </div>
    <figure class="hero-image">
      <img
        src="/images/deck-concept.png"
        alt={hero.imageAlt}
        width="1672"
        height="941"
        fetchpriority="high"
      />
      <div class="image-tag">
        {hero.imageTag}
        <br />
        <span>{hero.imageTagSub}</span>
      </div>
      <figcaption>
        <span>{hero.figLabel}</span>
        <span>{hero.figNote}</span>
      </figcaption>
    </figure>
    <div class="tuner" aria-hidden="true">
      <span>{hero.tunerBand}</span>
      <div class="scale">
        <div class="numbers">
          <span>21</span>
          <span>25</span>
          <span>30</span>
          <span>35</span>
          <span>40</span>
          <span>45</span>
          <span>50</span>
          <span>60</span>
        </div>
        <i></i>
      </div>
      <span>{hero.tunerCaption}</span>
    </div>
    <div class="hero-foot micro">
      <span>{hero.footLeft}</span>
      <span class="amber-label">{hero.footStatus}</span>
    </div>
  </section>
  <section id="object" class="editorial-section wrap">
    <div class="section-marker micro">
      <span>{object.marker}</span>
      <span>{object.aside}</span>
    </div>
    <div class="editorial-grid">
      <h2>
        {object.titleLine1}
        <br />
        {object.titleLine2}
      </h2>
      <div class="prose-intro">
        {object.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <div class="link-row">
          <a class="text-link" href="#process">
            {object.approachCta} <span>↗</span>
          </a>
          <a class="text-link" href={storyHref}>
            {object.originCta} <span>↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="object-details">
      {object.points.map((point) => (
        <div>
          <span class="micro">{point.kicker}</span>
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </div>
      ))}
    </div>
  </section>
  <section id="signal" class="signal-section">
    <div class="wrap">
      <div class="section-marker micro">
        <span>{signal.marker}</span>
        <span>{signal.aside}</span>
      </div>
      <div class="section-title">
        <h2>
          {signal.titleLine1}
          <br />
          {signal.titleLine2}
        </h2>
        <p>
          {signal.lead.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      </div>
      <SignalPath />
    </div>
  </section>
  <section id="process" class="editorial-section wrap">
    <div class="section-marker micro">
      <span>{process.marker}</span>
      <span>{process.aside}</span>
    </div>
    <div class="editorial-grid">
      <h2>
        {process.titleLine1}
        <br />
        {process.titleLine2}
      </h2>
      <p class="large-copy">{process.lead}</p>
    </div>
    <div class="process-grid">
      {process.steps.map((step) => (
        <div>
          <span class="process-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <span class="micro">{step.tag}</span>
        </div>
      ))}
    </div>
  </section>
  <section class="journal-section wrap">
    <div class="section-marker micro">
      <span>{journal.marker}</span>
      <span>{journal.aside}</span>
    </div>
    <div class="section-title">
      <h2>{journal.title}</h2>
      <a class="text-link" href={journalHref}>
        {journal.cta} <span>↗</span>
      </a>
    </div>
    <div class="journal-grid">
      {entries.map((entry) => (
        <JournalCard entry={entry} />
      ))}
    </div>
    <p class="editorial-note">{journal.note}</p>
  </section>
  <section id="about" class="about-section wrap">
    <span class="micro">{about.kicker}</span>
    <div>
      <h2>{about.title}</h2>
      {about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="link-row">
        <a class="text-link" href={storyHref}>
          {about.originCta} <span>↗</span>
        </a>
        <a class="text-link" href={journalHref}>
          {about.journalCta} <span>↗</span>
        </a>
      </div>
    </div>
    <div class="about-stamp micro">
      {about.stamp[0]}
      <br />
      {about.stamp[1]}
      <br />
      <span>
        {about.stamp[2]}
        <br />
        {about.stamp[3]}
      </span>
    </div>
  </section>
</Layout>
