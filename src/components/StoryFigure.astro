---
import type { CollectionEntry } from 'astro:content';
import type { StoryFigureId } from '../lib/story-markdown';

type StoryData = Extract<CollectionEntry<'pages'>['data'], { page: 'story' }>;

interface Props {
  id: StoryFigureId;
  figure: StoryData['figures'][StoryFigureId];
}

const { id, figure } = Astro.props;
---

<figure class="story-figure">
  {id === 'snow' && 'set' in figure && (
    <svg viewBox="0 0 880 420" role="img" aria-label={figure.alt}>
      <rect width="880" height="420" fill="#e6e2d8" />
      <rect
        x="150"
        y="36"
        width="580"
        height="320"
        fill="none"
        stroke="#252620"
        stroke-width="1.5"
      />
      <rect x="190" y="64" width="500" height="250" fill="#252620" />
      <g fill="#d5d0c4" opacity="0.85">
        <rect x="214" y="84" width="6" height="4" />
        <rect x="248" y="110" width="10" height="3" />
        <rect x="290" y="92" width="4" height="8" />
        <rect x="330" y="140" width="14" height="3" />
        <rect x="380" y="100" width="5" height="5" />
        <rect x="420" y="160" width="8" height="3" />
        <rect x="470" y="88" width="4" height="10" />
        <rect x="520" y="130" width="12" height="3" />
        <rect x="560" y="180" width="6" height="6" />
        <rect x="610" y="96" width="8" height="3" />
        <rect x="230" y="200" width="5" height="7" />
        <rect x="300" y="230" width="10" height="3" />
        <rect x="360" y="210" width="4" height="4" />
        <rect x="440" y="250" width="16" height="3" />
        <rect x="510" y="220" width="6" height="8" />
        <rect x="580" y="260" width="9" height="3" />
        <rect x="640" y="200" width="4" height="5" />
        <rect x="260" y="270" width="7" height="3" />
        <rect x="400" y="120" width="3" height="9" />
        <rect x="490" y="190" width="11" height="3" />
      </g>
      <text
        x="440"
        y="200"
        text-anchor="middle"
        fill="#f2f0e9"
        font-family="ui-monospace, monospace"
        font-size="18"
        letter-spacing="4"
      >
        {figure.screen}
      </text>
      <text
        x="150"
        y="390"
        fill="#686961"
        font-family="ui-monospace, monospace"
        font-size="12"
        letter-spacing="2"
      >
        {figure.set}
      </text>
    </svg>
  )}
  {id === 'shelf' && 'have' in figure && (
    <svg viewBox="0 0 880 360" role="img" aria-label={figure.alt}>
      <rect width="880" height="360" fill="#e6e2d8" />
      <text
        x="48"
        y="42"
        fill="#686961"
        font-family="ui-monospace, monospace"
        font-size="12"
        letter-spacing="2"
      >
        {figure.owned}
      </text>
      {figure.have.map((label, index) => {
        const x = 48 + (index % 4) * 200;
        const y = 64 + Math.floor(index / 4) * 78;
        return (
          <g>
            <rect
              x={x}
              y={y}
              width="176"
              height="58"
              fill="#f2f0e9"
              stroke="#252620"
            />
            <text
              x={x + 16}
              y={y + 36}
              fill="#252620"
              font-family="ui-monospace, monospace"
              font-size="13"
              letter-spacing="1.5"
            >
              {label}
            </text>
          </g>
        );
      })}
      <text
        x="48"
        y="250"
        fill="#b63d2e"
        font-family="ui-monospace, monospace"
        font-size="12"
        letter-spacing="2"
      >
        {figure.missing}
      </text>
      {figure.lack.map((label, index) => (
        <g>
          <rect
            x={48 + index * 200}
            y="266"
            width="176"
            height="58"
            fill="none"
            stroke="#b63d2e"
            stroke-dasharray="4 4"
          />
          <text
            x={64 + index * 200}
            y="302"
            fill="#b63d2e"
            font-family="ui-monospace, monospace"
            font-size="13"
            letter-spacing="1.5"
          >
            {label}
          </text>
        </g>
      ))}
    </svg>
  )}
  {id === 'path' && 'steps' in figure && (
    <svg viewBox="0 0 880 280" role="img" aria-label={figure.alt}>
      <rect width="880" height="280" fill="#e6e2d8" />
      {figure.steps.map((step, index) => {
        const x = 48 + index * 280;
        const aside = index === 1;
        return (
          <g>
            <rect
              x={x}
              y="48"
              width="220"
              height="160"
              fill={aside ? 'none' : '#f2f0e9'}
              stroke={aside ? '#b63d2e' : '#252620'}
              stroke-dasharray={aside ? '5 4' : '0'}
            />
            <text
              x={x + 18}
              y="84"
              fill="#b8702b"
              font-family="ui-monospace, monospace"
              font-size="12"
              letter-spacing="2"
            >
              {step.n}
            </text>
            <text
              x={x + 18}
              y="124"
              fill="#252620"
              font-family="Helvetica, Arial, sans-serif"
              font-size="18"
            >
              {step.title}
            </text>
            <text
              x={x + 18}
              y="160"
              fill="#686961"
              font-family="ui-monospace, monospace"
              font-size="12"
              letter-spacing="1.5"
            >
              {step.detail}
            </text>
            {index < 2 && (
              <text
                x={x + 232}
                y="136"
                fill="#8d8b7f"
                font-family="ui-monospace, monospace"
                font-size="18"
              >
                →
              </text>
            )}
          </g>
        );
      })}
    </svg>
  )}
  {id === 'chassis' && 'plate' in figure && (
    <svg viewBox="0 0 880 420" role="img" aria-label={figure.alt}>
      <rect width="880" height="420" fill="#e6e2d8" />
      <rect
        x="70"
        y="40"
        width="740"
        height="300"
        fill="#f2f0e9"
        stroke="#252620"
        stroke-width="1.5"
      />
      <circle cx="170" cy="130" r="42" fill="none" stroke="#252620" />
      <circle cx="170" cy="130" r="3" fill="#b8702b" />
      <text
        x="170"
        y="196"
        text-anchor="middle"
        fill="#686961"
        font-family="ui-monospace, monospace"
        font-size="11"
        letter-spacing="2"
      >
        {figure.meters}
      </text>
      <circle cx="280" cy="130" r="42" fill="none" stroke="#252620" />
      <circle cx="280" cy="130" r="3" fill="#b8702b" />
      <text
        x="280"
        y="196"
        text-anchor="middle"
        fill="#686961"
        font-family="ui-monospace, monospace"
        font-size="11"
        letter-spacing="2"
      >
        {figure.meters}
      </text>
      <rect x="430" y="78" width="300" height="168" fill="#252620" />
      <text
        x="580"
        y="118"
        text-anchor="middle"
        fill="#f2f0e9"
        font-family="ui-monospace, monospace"
        font-size="12"
        letter-spacing="3"
      >
        {figure.screen}
      </text>
      <line
        x1="430"
        y1="168"
        x2="730"
        y2="168"
        stroke="#f2f0e9"
        stroke-width="1"
      />
      <rect
        x="110"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <rect
        x="150"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <rect
        x="190"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <rect
        x="230"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <rect
        x="270"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <rect
        x="310"
        y="250"
        width="28"
        height="52"
        fill="none"
        stroke="#252620"
      />
      <text
        x="80"
        y="380"
        fill="#252620"
        font-family="ui-monospace, monospace"
        font-size="13"
        letter-spacing="3"
      >
        {figure.plate}
      </text>
    </svg>
  )}
  <figcaption>
    <span>{figure.caption}</span>
    <span>{figure.note}</span>
  </figcaption>
</figure>
